{
  "name": "sms-automation-backend",
  "version": "1.0.0",
  "description": "Enterprise SMS Automation Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
